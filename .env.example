# ── Prelo Booking — environment template ─────────────────────────────────────
# Copy to .env and fill. Resolution order (house rule): canonical local .env →
# session env vars → placeholder here + mock in code + runbook entry.

# Core
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-long-random

# Database — ALWAYS the public proxy URL, NEVER .railway.internal
DATABASE_URL=postgres://user:pass@host:5432/prelo_booking

# Stripe — TEST MODE ONLY (sk_test_...). Absent → PaymentsProvider mock.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Resend — absent → email logged to console (mock)
RESEND_API_KEY=
EMAIL_FROM=bookings@prelobooking.example

# ElevenLabs voice agent — absent → tool webhooks still live, agent config committed
ELEVENLABS_API_KEY=
ELEVENLABS_TOOL_SECRET=dev-tool-secret-change-me
ELEVENLABS_AGENT_ID=

# Google Calendar (per-staff OAuth) — absent → feature flag off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Feature flags (auto-derived from keys above; override with true/false)
# PAYMENTS_MODE=mock|stripe
# EMAIL_MODE=mock|resend
# GOOGLE_CALENDAR_ENABLED=false
